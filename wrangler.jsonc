// Cloudflare Workers settings: serve the built site in public/ as static files.
// public/_headers and public/_redirects add the security headers, caching and redirects.
// "name" must match the Worker's name in the Cloudflare dashboard.
{
  "name": "atlasofcities",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The site's own domain (registered with Cloudflare): each deploy keeps both names attached to this Worker,
  // with their DNS records and certificates. The workers.dev address keeps working too, for old links.
  "routes": [
    { "pattern": "atlasofcities.org", "custom_domain": true },
    { "pattern": "www.atlasofcities.org", "custom_domain": true }
  ],
  "workers_dev": true
}
